    macros {
        mc0: mc0 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&out OUT_BLE &bt BT_SEL 0 &to 0>;
            label = "MC0";
        };

        mc1: mc1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&out OUT_BLE &bt BT_SEL 1 &to 0>;
            label = "MC1";
        };

        mc2: mc2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&out OUT_BLE &bt BT_SEL 2 &to 4>;
            label = "MC2";
        };

        mc3: mc3 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&out OUT_BLE &bt BT_SEL 3 &to 0>;
            label = "MC3";
        };

        mc4: mc4 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&out OUT_BLE &bt BT_SEL 4 &to 0>;
            label = "MC4";
        };

        mc00: mc00 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_pause_for_release>,
                <&kp LS(N8) &kp LS(N9) &kp LEFT>;

            label = "MC00";
        };

        mc01: mc01 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_pause_for_release>,
                <&kp LANG2 &kp N1 &kp LC(ENTER)>;

            label = "MC01";
        };

        mc02: mc02 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_pause_for_release>,
                <&kp LANG2 &kp N2 &kp LC(ENTER)>;

            label = "MC02";
        };

        mc03: mc03 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_pause_for_release>,
                <&kp LANG2 &kp N3 &kp LC(ENTER)>;

            label = "MC03";
        };

        mc04: mc04 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_pause_for_release>,
                <&kp LANG2 &kp MINUS &kp LC(ENTER)>;

            label = "MC04";
        };

        mc05: mc05 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_pause_for_release>,
                <&kp LANG2 &kp PERIOD &kp LC(ENTER)>;

            label = "MC05";
        };

        mc06: mc06 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_pause_for_release>,
                <&kp LA(LC(V)) &kp T &kp ENTER>;

            label = "MC06";
        };

        mc07: mc07 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_pause_for_release>,
                <&kp LA(LC(V)) &kp F &kp ENTER>;

            label = "MC07";
        };

        mc08: mc08 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_pause_for_release>,
                <&kp LA(LC(V)) &kp V &kp ENTER>;

            label = "MC08";
        };

        mc09: mc09 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_pause_for_release>, <&kp LA(H) &kp A &kp L>;

            label = "MC09";
        };

        mc10: mc10 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_pause_for_release>, <&kp LA(H) &kp A &kp C>;

            label = "MC10";
        };

        mc11: mc11 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_pause_for_release>, <&kp LA(H) &kp A &kp R>;

            label = "MC11";
        };

        mc12: mc12 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press>, <&kp GLOBE &kp UP>, <&macro_release>;

            label = "MC12";
        };

        mc13: mc13 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press>, <&kp GLOBE &kp LEFT>, <&macro_release>;

            label = "MC13";
        };

        mc14: mc14 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press>, <&kp GLOBE &kp RIGHT>, <&macro_release>;

            label = "MC14";
        };

        mc15: mc15 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press>, <&kp GLOBE &kp N>, <&macro_release>;

            label = "MC15";
        };

        mc16: mc16 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press>, <&kp GLOBE &kp C>, <&macro_release>;

            label = "MC16";
        };
    };

    combos {
        compatible = "zmk,combos";

        combo00 {
            bindings = <&kp ESC>;
            key-positions = <0 1>;
        };

        combo01 {
            bindings = <&kp TAB>;
            key-positions = <10 11>;
        };

        combo02 {
            bindings = <&kp CAPS>;
            key-positions = <20 21>;
        };

        combo03 {
            bindings = <&kp LANG2>;
            key-positions = <34 35>;
        };

        combo04 {
            bindings = <&none>;
            key-positions = <5 6>;
        };

        combo05 {
            bindings = <&us_bq>;
            key-positions = <6 7>;
        };

        combo06 {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <7 8>;
        };

        combo07 {
            bindings = <&kp NON_US_HASH>;
            key-positions = <8 9>;
        };

        combo08 {
            bindings = <&mc00>;
            key-positions = <7 8 9>;
        };

        combo09 {
            bindings = <&kp LANG2>;
            key-positions = <15 16>;
        };

        combo10 {
            bindings = <&kp INT3>;
            key-positions = <16 17>;
        };

        combo11 {
            bindings = <&us_ap>;
            key-positions = <17 18>;
        };

        combo12 {
            bindings = <&us_se>;
            key-positions = <18 19>;
        };

        combo14 {
            bindings = <&kp N0>;
            key-positions = <26 27>;
            layers = <1 5>;
        };

        combo15 {
            bindings = <&kp SLASH>;
            key-positions = <26 27>;
        };

        combo16 {
            bindings = <&kp COMMA>;
            key-positions = <27 28>;
        };

        combo18 {
            bindings = <&kp DOT>;
            key-positions = <28 29>;
        };

        combo19 {
            bindings = <&kp LANG1>;
            key-positions = <36 37>;
        };

        combo20 {
            bindings = <&kp DEL>;
            key-positions = <10 0>;
        };

        combo21 {
            bindings = <&kp BACKSPACE>;
            key-positions = <10 20>;
        };

        combo22 {
            bindings = <&mkp MB1>;
            key-positions = <1 11>;
        };

        combo23 {
            bindings = <&mkp MB2>;
            key-positions = <2 12>;
        };

        combo24 {
            bindings = <&kp LEFT>;
            key-positions = <13 23>;
        };

        combo25 {
            bindings = <&kp RIGHT>;
            key-positions = <14 24>;
        };

        combo26 {
            bindings = <&kp UP>;
            key-positions = <14 13>;
        };

        combo27 {
            bindings = <&kp DOWN>;
            key-positions = <23 24>;
        };

        combo28 {
            bindings = <&mkp MB1>;
            key-positions = <7 17>;
        };

        combo29 {
            bindings = <&mkp MB2>;
            key-positions = <18 8>;
        };

        combo30 {
            bindings = <&kp TAB>;
            key-positions = <19 9>;
        };

        combo31 {
            bindings = <&kp ENTER>;
            key-positions = <19 29>;
        };

        combo32 {
            bindings = <&bt BT_CLR>;
            key-positions = <20 21 22>;
            layers = <3 7>;
        };

        combo33 {
            bindings = <&bt BT_CLR_ALL>;
            key-positions = <27 28 29>;
            layers = <3 7>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            bindings = <
&lt 3 Q      &lt 2 W  &lt 1 E     &kp R       &kp T                                  &trans           &kp Y        &kp U       &lt 2 I     &lt 3 O
&lt 2 A      &kp S    &mt LALT D  &mt LGUI F  &mt LCTRL G                            &trans           &mt LCTRL H  &mt LGUI J  &mt RALT K  &kp P
&mt LSHFT Z  &lt 8 X  &kp C       &kp V       &kp B                                  &TD03            &TD04        &kp N       &kp M       &mt RSHFT L
&trans       &trans   &trans      &kp UP      &lt 2 ENTER  &lt 1 SPACE    &lt 2 TAB  &lt 1 BACKSPACE  &trans       &trans      &trans      &trans
                      &kp LEFT    &kp DOWN    &kp RIGHT                              &trans           &trans       &trans
            >;
        };

        layer_1 {
            bindings = <
&TD10   &mc02      &mc03         &kp LC(HOME)  &TD14                                          &kp HOME   &kp END    &kp N7  &kp N8  &kp N9
&TD15   &TD16      &TD17         &TD18         &mt LCTRL LC(PAGE_DOWN)                        &kp PG_UP  &kp PG_DN  &kp N4  &kp N5  &kp N6
&TD20   &kp LC(X)  &kp LC(C)     &TD23         &kp LC(B)                                      &TD07      &kp N0     &kp N1  &kp N2  &kp N3
&trans  &trans     &trans        &kp C_VOL_UP  &kp ENTER                &kp SPACE    &kp TAB  &kp BSPC   &trans     &kp N0  &trans  &trans
                   &kp C_BRI_DN  &kp C_VOL_DN  &kp C_BRI_UP                                   &trans     &trans     &trans
            >;
        };

        layer_2 {
            bindings = <
&mt F1 LA(LC(TAB))  &kp F2   &kp F3                 &kp F4          &kp F5                                      &kp LC(T)          &kp LS(LC(TAB))  &kp UP    &kp LC(TAB)  &mt LS(F5) LC(W)
&kp F6              &kp F7   &kp F8                 &kp F9          &kp F10                                     &kp LA(LEFT)       &kp LEFT         &kp DOWN  &kp RIGHT    &kp F3
&kp F11             &kp F12  &mt LG(P) PRINTSCREEN  &trans          &trans                                      &kp LC(KP_MINUS)   &kp LC(KP_PLUS)  &trans    &trans       &trans
&trans              &trans   &trans                 &mmv MOVE_UP    &TD28            &TD29    &kp LS(LG(LEFT))  &kp LS(LG(RIGHT))  &trans           &trans    &trans       &trans
                             &mmv MOVE_LEFT         &mmv MOVE_DOWN  &mmv MOVE_RIGHT                             &trans             &trans           &trans
            >;
        };

        layer_3 {
            bindings = <
&trans       &mc0            &mc1            &mc2            &mc3                                       &mc3       &mc2          &mc1    &mc0            &trans
&sys_reset   &trans          &trans          &out OUT_USB    &mc4                                       &mc4       &out OUT_USB  &trans  &trans          &sys_reset
&bootloader  &studio_unlock  &trans          &trans          &trans                                     &trans     &trans        &trans  &studio_unlock  &bootloader
&trans       &trans          &trans          &msc SCRL_UP    &kp LG(L)        &kp LA(F4)    &kp LA(F4)  &kp LG(L)  &trans        &trans  &trans          &trans
                             &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_RIGHT                            &trans     &trans        &trans
            >;
        };

        layer_4 {
            bindings = <
&lt 7 Q      &lt 6 W      &lt 5 E     &kp R        &kp T                                  &trans           &kp Y       &kp U        &lt 6 I     &lt 7 O
&lt 6 A      &mt GLOBE S  &mt LALT D  &mt LCTRL F  &mt LGUI G                             &trans           &mt RGUI H  &mt RCTRL J  &mt RALT K  &mt GLOBE P
&mt LSHFT Z  &lt 8 X      &kp C       &kp V        &kp B                                  &TD03            &TD04       &kp N        &kp M       &mt RSHFT L
&trans       &trans       &trans      &kp UP       &lt 6 ENTER  &lt 5 SPACE    &lt 6 TAB  &lt 5 BACKSPACE  &trans      &trans       &trans      &trans
                          &kp LEFT    &kp DOWN     &kp RIGHT                              &trans           &trans      &trans
            >;
        };

        layer_5 {
            bindings = <
&mc15      &trans     &trans        &trans        &mc16                               &kp HOME   &kp END    &kp N7  &kp N8  &kp N9
&kp LG(A)  &kp LG(S)  &trans        &trans        &trans                              &kp PG_UP  &kp PG_DN  &kp N4  &kp N5  &kp N6
&kp LG(Z)  &kp LG(X)  &kp LG(C)     &kp LG(V)     &kp LG(B)                           &TD07      &kp N0     &kp N1  &kp N2  &kp N3
&trans     &trans     &trans        &kp C_VOL_UP  &kp ENTER     &kp SPACE    &kp TAB  &kp BSPC   &trans     &kp N0  &trans  &trans
                      &kp C_BRI_DN  &kp C_VOL_DN  &kp C_BRI_UP                        &trans     &trans     &trans
            >;
        };

        layer_6 {
            bindings = <
&mc12    &kp F2   &kp F3          &kp F4          &kp F5                                  &kp LG(T)              &kp LS(LC(TAB))  &kp UP    &kp LC(TAB)  &mt LG(R) LG(W)
&kp F6   &kp F7   &kp F8          &kp F9          &kp F10                                 &kp LG(RIGHT_BRACKET)  &kp LEFT         &kp DOWN  &kp RIGHT    &kp LG(F)
&kp F11  &kp F12  &kp LG(LS(N4))  &trans          &trans                                  &kp LG(KP_MINUS)       &kp LG(KP_PLUS)  &trans    &trans       &trans
&trans   &trans   &trans          &mmv MOVE_UP    &mc13            &mc14    &kp LG(LEFT)  &kp LG(RIGHT)          &trans           &trans    &trans       &trans
                  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT                         &trans                 &trans           &trans
            >;
        };

        layer_7 {
            bindings = <
&trans       &mc0            &mc1            &mc2            &mc3                                     &mc3           &mc2          &mc1    &mc0            &trans
&sys_reset   &trans          &trans          &out OUT_USB    &mc4                                     &mc4           &out OUT_USB  &trans  &trans          &sys_reset
&bootloader  &studio_unlock  &trans          &trans          &trans                                   &trans         &trans        &trans  &studio_unlock  &bootloader
&trans       &trans          &trans          &msc SCRL_UP    &kp LG(LC(Q))    &kp LG(H)    &kp LG(H)  &kp LG(LC(Q))  &trans        &trans  &trans          &trans
                             &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_RIGHT                          &trans         &trans        &trans
            >;
        };

        layer_8 {
            bindings = <
&trans  &trans  &trans  &trans  &trans                    &trans  &trans  &kp LS(N6)  &kp LS(N8)        &kp LS(N9)
&trans  &trans  &trans  &trans  &trans                    &trans  &trans  &kp LS(N4)  &kp LS(N5)        &kp EQUAL
&trans  &trans  &trans  &trans  &trans                    &TD08   &TD09   &kp LS(N1)  &kp LEFT_BRACKET  &kp LS(N3)
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans      &trans            &trans
                &trans  &trans  &trans                    &trans  &trans  &trans
            >;
        };
    };
};
