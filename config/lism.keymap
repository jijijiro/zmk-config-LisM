            bindings = <&none>;
            tapping-term-ms = <300>;
        };

        TD18: TD18 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD18";
            #binding-cells = <0>;
            bindings = <&kp F4>, <&mc07>;

            tapping-term-ms = <300>;
        };

        TD19: TD19 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD19";
            #binding-cells = <0>;
            bindings = <&none>;
            tapping-term-ms = <300>;
        };

        TD20: TD20 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD20";
            #binding-cells = <0>;
            bindings = <&none>;
            tapping-term-ms = <300>;
        };

        TD21: TD21 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD21";
            #binding-cells = <0>;
            bindings = <&none>;
            tapping-term-ms = <300>;
        };

        TD22: TD22 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD22";
            #binding-cells = <0>;
            bindings = <&none>;
            tapping-term-ms = <300>;
        };

        TD23: TD23 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD23";
            #binding-cells = <0>;
            bindings = <&kp F9>, <&mc08>;

            tapping-term-ms = <300>;
        };

        TD24: TD24 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD24";
            #binding-cells = <0>;
            bindings = <&none>;
            tapping-term-ms = <300>;
        };

        TD25: TD25 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD25";
            #binding-cells = <0>;
            bindings = <&none>;
            tapping-term-ms = <300>;
        };

        TD26: TD26 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD26";
