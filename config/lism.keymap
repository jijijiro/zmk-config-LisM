            tapping-term-ms = <300>;
        };

        TD31: TD31 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD31";
            #binding-cells = <0>;
            bindings = <&none>;
            tapping-term-ms = <300>;
        };
