#define ZMK_POINTING_DEFAULT_SCRL_VAL 20

#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
    tapping-term-ms = <300>;
    flavor = "balanced";
    require-prior-idle-ms = <200>;
};

&lt {
    tapping-term-ms = <300>;
    require-prior-idle-ms = <200>;
    flavor = "balanced";
};

/ {
    behaviors {
        encoder_msc: sensor_rotate_msc {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;

            tap-ms = <20>;
        };

        encoder_kp: sensor_rotate_kp {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&kp>, <&kp>;
        };

        us_bq: us_bq {
            compatible = "zmk,behavior-mod-morph";
            label = "US_BQ";
            bindings = <&kp LS(LEFT_BRACKET)>, <&kp LS(EQUAL)>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        us_min: us_min {
            compatible = "zmk,behavior-mod-morph";
            label = "US_MIN";
            bindings = <&kp MINUS>, <&kp LS(INT1)>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        us_pl: us_pl {
            compatible = "zmk,behavior-mod-morph";
            label = "US_PL";
            bindings = <&kp LS(MINUS)>, <&kp LS(SEMI)>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        us_se: us_se {
            compatible = "zmk,behavior-mod-morph";
            label = "US_SE";
            bindings = <&kp SEMI>, <&kp APOS>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        us_ap: us_ap {
            compatible = "zmk,behavior-mod-morph";
            label = "US_AP";
            bindings = <&kp LS(N7)>, <&kp LS(N2)>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        TD00: TD00 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD00";
            #binding-cells = <0>;
            bindings = <&none>;
            tapping-term-ms = <300>;
        };

        TD01: TD01 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD01";
            #binding-cells = <0>;
            bindings = <&us_min>, <&us_pl>;

            tapping-term-ms = <300>;
        };

        TD02: TD02 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD02";
            #binding-cells = <0>;
            bindings = <&kp COMMA>, <&us_se>;

            tapping-term-ms = <300>;
        };

        TD03: TD03 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD03";
            #binding-cells = <0>;
            bindings = <&kp DOT>, <&us_ap>;

            tapping-term-ms = <300>;
        };

        TD04: TD04 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD04";
            #binding-cells = <0>;
            bindings = <&mt RSHFT SLASH>, <&kp INT3>;

            tapping-term-ms = <300>;
        };

        TD05: TD05 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD05";
            #binding-cells = <0>;
            bindings = <&none>;
            tapping-term-ms = <300>;
        };

        TD06: TD06 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD06";
            #binding-cells = <0>;
            bindings = <&none>;
            tapping-term-ms = <300>;
        };

        TD07: TD07 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD07";
            #binding-cells = <0>;
            bindings = <&none>;
            tapping-term-ms = <300>;
        };

        TD08: TD08 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD08";
            #binding-cells = <0>;
            bindings = <&none>;
            tapping-term-ms = <300>;
        };

        TD09: TD09 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD09";
            #binding-cells = <0>;
            bindings = <&lt 3 DOT>, <&kp APOS>, <&kp COMMA>;

            tapping-term-ms = <300>;
        };

        TD10: TD10 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD10";
            #binding-cells = <0>;
            bindings = <&mc01>, <&kp LC(LS(F1))>;

            tapping-term-ms = <300>;
        };

        TD11: TD11 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD11";
            #binding-cells = <0>;
            bindings = <&none>;
            tapping-term-ms = <300>;
        };

        TD12: TD12 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD12";
            #binding-cells = <0>;
            bindings = <&none>;
            tapping-term-ms = <300>;
        };

        TD13: TD13 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD13";
            #binding-cells = <0>;
            bindings = <&none>;
            tapping-term-ms = <300>;
        };

        TD14: TD14 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD14";
            #binding-cells = <0>;
            bindings = <&mc05>, <&mc06>;

            tapping-term-ms = <300>;
        };

        TD15: TD15 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD15";
            #binding-cells = <0>;
            bindings = <&kp LC(A)>, <&mc09>;

            tapping-term-ms = <300>;
        };

        TD16: TD16 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD16";
            #binding-cells = <0>;
            bindings = <&kp LC(S)>, <&mc10>;

            tapping-term-ms = <300>;
        };

        TD17: TD17 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD17";
            #binding-cells = <0>;
            bindings = <&kp LALT>, <&mc11>;

            tapping-term-ms = <300>;
        };

        TD18: TD18 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD18";
            #binding-cells = <0>;
            bindings = <&mt LGUI LC(PG_UP)>, <&mc07>;

            tapping-term-ms = <300>;
        };

        TD19: TD19 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD19";
            #binding-cells = <0>;
            bindings = <&none>;
            tapping-term-ms = <300>;
        };

        TD20: TD20 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD20";
            #binding-cells = <0>;
            bindings = <&mt LSHFT LC(Z)>, <&kp LC(N1)>;

            tapping-term-ms = <300>;
        };

        TD21: TD21 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD21";
            #binding-cells = <0>;
            bindings = <&none>;
            tapping-term-ms = <300>;
        };

        TD22: TD22 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD22";
            #binding-cells = <0>;
            bindings = <&none>;
            tapping-term-ms = <300>;
        };

        TD23: TD23 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD23";
            #binding-cells = <0>;
            bindings = <&kp LC(V)>, <&mc08>;

            tapping-term-ms = <300>;
        };

        TD24: TD24 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD24";
            #binding-cells = <0>;
            bindings = <&none>;
            tapping-term-ms = <300>;
        };

        TD25: TD25 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD25";
            #binding-cells = <0>;
            bindings = <&none>;
            tapping-term-ms = <300>;
        };

        TD26: TD26 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD26";
            #binding-cells = <0>;
            bindings = <&none>;
            tapping-term-ms = <300>;
        };

        TD27: TD27 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD27";
            #binding-cells = <0>;
            bindings = <&none>;
            tapping-term-ms = <300>;
        };

        TD28: TD28 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD28";
            #binding-cells = <0>;
            bindings = <&kp LC(LG(LEFT))>, <&kp LC(LG(LA(LEFT)))>;

            tapping-term-ms = <300>;
        };

        TD29: TD29 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD29";
            #binding-cells = <0>;
            bindings = <&kp LC(LG(RIGHT))>, <&kp LC(LG(LA(RIGHT)))>;

            tapping-term-ms = <300>;
        };

        TD30: TD30 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD30";
            #binding-cells = <0>;
            bindings = <&none>;
            tapping-term-ms = <300>;
        };

        TD31: TD31 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD31";
            #binding-cells = <0>;
            bindings = <&none>;
            tapping-term-ms = <300>;
        };
    };

    macros {
        mouse: mouse {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&mkp MB1 &mkp MB1>;
            label = "MOUSE";
        };

        bt00: bt00 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&out OUT_BLE &bt BT_SEL 0 &to 0>;
            label = "BT00";
        };

        bt01: bt01 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&out OUT_BLE &bt BT_SEL 1 &to 4>;
            label = "BT01";
        };

        bt02: bt02 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&out OUT_BLE &bt BT_SEL 2 &to 0>;
            label = "BT02";
        };

        bt03: bt03 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&out OUT_BLE &bt BT_SEL 3 &to 0>;
            label = "BT03";
        };

        bt04: bt04 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&out OUT_BLE &bt BT_SEL 4 &to 0>;
            label = "BT04";
        };

        mc00: mc00 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(N8) &kp LS(N9) &kp LEFT>;
            label = "MC00";
        };

        mc01: mc01 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_pause_for_release>,
                <&kp LANG2 &kp N1 &kp LC(ENTER)>;

            label = "MC01";
        };

        mc02: mc02 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_pause_for_release>,
                <&kp LANG2 &kp N2 &kp LC(ENTER)>;

            label = "MC02";
        };

        mc03: mc03 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_pause_for_release>,
                <&kp LANG2 &kp N3 &kp LC(ENTER)>;

            label = "MC03";
        };

        mc04: mc04 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_pause_for_release>,
                <&kp LANG2 &kp MINUS &kp LC(ENTER)>;

            label = "MC04";
        };

        mc05: mc05 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_pause_for_release>,
                <&kp LANG2 &kp DOT &kp LC(ENTER)>;

            label = "MC05";
        };

        mc06: mc06 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_pause_for_release>,
                <&kp LC(LA(V)) &kp T &kp ENTER>;

            label = "MC06";
        };

        mc07: mc07 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_pause_for_release>,
                <&kp LC(LA(V)) &kp F &kp ENTER>;

            label = "MC07";
        };

        mc08: mc08 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_pause_for_release>,
                <&kp LC(LA(V)) &kp V &kp ENTER>;

            label = "MC08";
        };

        mc09: mc09 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LA(H) &kp A &kp L>;
            label = "MC09";
        };

        mc10: mc10 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LA(H) &kp A &kp C>;
            label = "MC10";
        };

        mc11: mc11 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LA(H) &kp A &kp R>;
            label = "MC11";
        };

        ios00: ios00 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp GLOBE &kp H>,
                <&macro_release>,
                <&kp GLOBE>;

            label = "IOS00";
        };

        ios01: ios01 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp GLOBE &kp A>,
                <&macro_release>,
                <&kp GLOBE>;

            label = "IOS01";
        };

        ios02: ios02 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp GLOBE &kp C>,
                <&macro_release>,
                <&kp GLOBE>;

            label = "IOS02";
        };

        ios03: ios03 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp GLOBE &kp UP>,
                <&macro_release>,
                <&kp GLOBE>;

            label = "IOS03";
        };

        ios04: ios04 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp GLOBE &kp LEFT>,
                <&macro_release>,
                <&kp GLOBE>;

            label = "IOS04";
        };

        ios05: ios05 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp GLOBE &kp RIGHT>,
                <&macro_release>,
                <&kp GLOBE>;

            label = "IOS05";
        };
    };

    combos {
        compatible = "zmk,combos";

        combo00 {
            bindings = <&kp ESC>;
            key-positions = <0 1>;
        };

        combo01 {
            bindings = <&kp TAB>;
            key-positions = <10 11>;
        };

        combo02 {
            bindings = <&kp LS(CAPSLOCK)>;
            key-positions = <20 21>;
            layers = <0>;
        };

        combo02_ {
            bindings = <&kp CAPSLOCK>;
            key-positions = <20 21>;
            layers = <4>;
        };

        combo03 {
            bindings = <&mo 10>;
            key-positions = <34 35>;
        };

        combo04 {
            bindings = <&mo 10>;
            key-positions = <36 37>;
        };

        combo05 {
            bindings = <&mc00>;
            key-positions = <6 7>;
        };

        combo06 {
            bindings = <&kp DEL>;
            key-positions = <0 10>;
        };

        combo07 {
            bindings = <&kp BACKSPACE>;
            key-positions = <1 11>;
        };

        combo08 {
            bindings = <&mkp MB2>;
            key-positions = <2 12>;
        };

        combo09 {
            bindings = <&mkp MB1>;
            key-positions = <3 13>;
        };

        combo10 {
            bindings = <&mouse>;
            key-positions = <4 14>;
        };

        combo11 {
            bindings = <&mouse>;
            key-positions = <5 15>;
        };

        combo12 {
            bindings = <&mkp MB1>;
            key-positions = <6 16>;
        };

        combo13 {
            bindings = <&mkp MB2>;
            key-positions = <7 17>;
        };

        combo14 {
            bindings = <&kp HOME>;
            key-positions = <3 4>;
        };

        combo15 {
            bindings = <&kp END>;
            key-positions = <13 14>;
        };

        combo16 {
            bindings = <&tog 1>;
            key-positions = <37 41>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            bindings = <
&lt 2 Q      &lt 3 W  &lt 8 E     &lt 9 R     &lt 10 T                                     &kp Y      &kp U   &kp I   &lt 3 O  &kp L
&kp A        &kp S    &mt LALT D  &mt LGUI F  &mt LCTRL G                                  &kp H      &kp J   &kp K   &kp P    &TD01
&mt LSHFT Z  &lt 8 X  &kp C       &kp V       &kp B                                        &kp N      &kp M   &TD02   &TD03    &TD04
&lt 3 LANG2  &trans   &trans      &trans      &lt 2 ENTER  &lt 1 SPACE    &lt 1 BACKSPACE  &lt 2 TAB  &trans  &trans  &trans   &lt 3 LANG1
                      &trans      &trans      &trans                                       &trans     &trans  &trans
            >;

            sensor-bindings = <&inc_dec_kp LEFT RIGHT>;
        };

        layer_1 {
            bindings = <
&TD10        &mc02        &mc03      &mc04   &TD14                                                &kp N7    &kp N8  &kp N9  &lt 3 STAR  &kp FSLH
&TD15        &TD16        &TD17      &TD18   &mt LCTRL LC(PG_DN)                                  &kp N4    &kp N5  &kp N6  &kp PLUS    &kp MINUS
&TD20        &lt 8 LC(X)  &kp LC(C)  &TD23   &kp LC(B)                                            &kp N1    &kp N2  &kp N3  &kp TAB     &mt RSHFT ENTER
&lt 3 LANG2  &trans       &trans     &trans  &lt 2 ENTER          &lt 9 SPACE    &lt 9 BACKSPACE  &lt 2 N0  &trans  &trans  &trans      &TD09
                          &trans     &trans  &trans                                               &trans    &trans  &trans
            >;

            sensor-bindings = <&inc_dec_kp LEFT RIGHT>;
        };

        layer_2 {
            bindings = <
&kp F1   &kp F2   &kp F3           &kp F4     &kp F5                           &kp HOME   &kp END    &trans  &trans  &trans
&kp F6   &kp F7   &kp F8           &kp F9     &kp F10                          &kp PG_UP  &kp PG_DN  &trans  &trans  &trans
&kp F11  &kp F12  &kp PRINTSCREEN  &kp LG(P)  &trans                           &trans     &trans     &trans  &trans  &trans
&trans   &trans   &trans           &trans     &kp LG(L)  &kp LA(F4)    &trans  &trans     &trans     &trans  &trans  &trans
                  &trans           &trans     &trans                           &trans     &trans     &trans
            >;

            sensor-bindings = <&inc_dec_kp UP DOWN>;
        };

        layer_3 {
            bindings = <
&kp LC(LA(TAB))  &kp UP    &kp LG(A)  &trans  &trans                             &trans             &trans  &trans    &kp UP    &trans
&kp LEFT         &kp DOWN  &kp RIGHT  &trans  &trans                             &trans             &trans  &kp LEFT  &kp DOWN  &kp RIGHT
&kp LG(T)        &trans    &trans     &trans  &trans                             &trans             &trans  &trans    &trans    &trans
&trans           &trans    &trans     &trans  &TD28   &TD29    &kp LG(LS(LEFT))  &kp LG(LS(RIGHT))  &trans  &trans    &trans    &trans
                           &trans     &trans  &trans                             &trans             &trans  &trans
            >;

            sensor-bindings = <&encoder_msc SCRL_LEFT SCRL_RIGHT>;
        };

        layer_4 {
            bindings = <
&lt 6 Q      &lt 7 W      &lt 8 E     &lt 9 R      &lt 10 T                                     &kp Y      &kp U   &kp I   &lt 7 O  &kp L
&kp A        &mt GLOBE S  &mt LALT D  &mt LCTRL F  &mt LGUI G                                   &kp H      &kp J   &kp K   &kp P    &TD01
&mt LSHFT Z  &lt 8 X      &kp C       &kp V        &kp B                                        &kp N      &kp M   &TD02   &TD03    &TD04
&lt 7 LANG2  &trans       &trans      &trans       &lt 6 ENTER  &lt 5 SPACE    &lt 5 BACKSPACE  &lt 6 TAB  &trans  &trans  &trans   &lt 7 LANG1
                          &trans      &trans       &trans                                       &trans     &trans  &trans
            >;

            sensor-bindings = <&inc_dec_kp LEFT RIGHT>;
        };

        layer_5 {
            bindings = <
&trans     &trans     &trans     &trans     &trans                            &kp N7  &kp N8  &kp N9  &lt 7 STAR  &kp FSLH
&kp LG(A)  &kp LG(S)  &trans     &trans     &trans                            &kp N4  &kp N5  &kp N6  &kp PLUS    &kp MINUS
&kp LG(Z)  &kp LG(X)  &kp LG(C)  &kp LG(V)  &kp LG(B)                         &kp N1  &kp N2  &kp N3  &kp TAB     &mt RSHFT ENTER
&kp LANG2  &trans     &trans     &trans     &kp ENTER  &kp SPACE    &kp BSPC  &kp N0  &trans  &trans  &trans      &kp LANG1
                      &trans     &trans     &trans                            &trans  &trans  &trans
            >;

            sensor-bindings = <&inc_dec_kp LEFT RIGHT>;
        };

        layer_6 {
            bindings = <
&kp F1   &kp F2   &kp F3          &kp F4          &kp F5                           &kp HOME   &kp END    &trans  &trans  &trans
&kp F6   &kp F7   &kp F8          &kp F9          &kp F10                          &kp PG_UP  &kp PG_DN  &trans  &trans  &trans
&kp F11  &kp F12  &kp LG(LS(N4))  &kp LG(LS(N3))  &trans                           &trans     &trans     &trans  &trans  &trans
&trans   &trans   &trans          &trans          &kp LG(LC(Q))  &ios00    &trans  &trans     &trans     &trans  &trans  &trans
                  &trans          &trans          &trans                           &trans     &trans     &trans
            >;

            sensor-bindings = <&inc_dec_kp UP DOWN>;
        };

        layer_7 {
            bindings = <
&ios03    &kp UP    &ios02     &trans  &trans                          &trans         &trans  &trans    &kp UP    &trans
&kp LEFT  &kp DOWN  &kp RIGHT  &trans  &trans                          &trans         &trans  &kp LEFT  &kp DOWN  &kp RIGHT
&ios01    &trans    &trans     &trans  &trans                          &trans         &trans  &trans    &trans    &trans
&trans    &trans    &trans     &trans  &ios04  &ios05    &kp LG(LEFT)  &kp LG(RIGHT)  &trans  &trans    &trans    &trans
                    &trans     &trans  &trans                          &trans         &trans  &trans
            >;

            sensor-bindings = <&encoder_msc SCRL_LEFT SCRL_RIGHT>;
        };

        layer_8 {
            bindings = <
&trans  &trans  &trans  &trans  &trans                    &kp LS(N6)  &kp LS(N8)        &kp LS(N9)  &kp LS(RIGHT_BRACKET)  &kp LS(NON_US_HASH)
&trans  &trans  &trans  &trans  &trans                    &kp LS(N4)  &kp LS(N5)        &kp EQUAL   &kp RIGHT_BRACKET      &kp NON_US_HASH
&trans  &trans  &trans  &trans  &trans                    &kp LS(N1)  &kp LEFT_BRACKET  &kp LS(N3)  &kp LS(LEFT_BRACKET)   &kp LS(EQUAL)
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans      &trans            &trans      &trans                 &trans
                &trans  &trans  &trans                    &trans      &trans            &trans
            >;

            sensor-bindings = <&encoder_msc SCRL_UP SCRL_DOWN>;
        };

        layer_9 {
            bindings = <
&kp Q      &kp W   &kp E   &kp R   &kp T                           &kp Y    &kp U   &kp I   &kp O   &kp L
&kp A      &kp S   &kp D   &kp F   &kp G                           &kp H    &kp J   &kp K   &kp P   &TD01
&kp Z      &kp X   &kp C   &kp V   &kp B                           &kp N    &kp M   &TD02   &TD03   &TD04
&kp LANG2  &trans  &trans  &trans  &kp RET  &kp SPACE    &kp BSPC  &kp TAB  &trans  &trans  &trans  &kp LANG1
                   &trans  &trans  &trans                          &trans   &trans  &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP>;
        };

        layer_10 {
            bindings = <
&bt00           &bt01   &bt02   &bt03   &bt04                                       &bt00           &bt01   &bt02   &bt03   &bt04
&out OUT_USB    &trans  &trans  &trans  &trans                                      &trans          &trans  &trans  &trans  &out OUT_USB
&trans          &trans  &trans  &trans  &bt BT_CLR_ALL                              &bt BT_CLR_ALL  &trans  &trans  &trans  &trans
&studio_unlock  &trans  &trans  &trans  &sys_reset      &bootloader    &bootloader  &sys_reset      &trans  &trans  &trans  &studio_unlock
                        &trans  &trans  &trans                                      &trans          &trans  &trans
            >;

            sensor-bindings = <&inc_dec_kp C_BRI_DN C_BRI_UP>;
        };
    };
};
