    macros {
        mc0: mc0 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&out OUT_BLE &bt BT_SEL 0 &mo 0>;
            label = "MC0";
        };

        mc1: mc1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&out OUT_BLE &bt BT_SEL 1 &mo 0>;
            label = "MC1";
        };

        mc2: mc2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&out OUT_BLE &bt BT_SEL 2 &mo 3>;
            label = "MC2";
        };

        mc3: mc3 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&out OUT_BLE &bt BT_SEL 3 &mo 0>;
            label = "MC3";
        };

        mc4: mc4 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&out OUT_BLE &bt BT_SEL 4 &mo 0>;
            label = "MC4";
        };

        mc00: mc00 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_pause_for_release>,
                <&kp LANG1 &kp LS(N8) &kp LS(N9) &kp LEFT>;

            label = "MC00";
        };

        mc01: mc01 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_pause_for_release>,
                <&kp LANG2 &kp N1 &kp LC(ENTER)>;

            label = "MC01";
        };

        mc02: mc02 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_pause_for_release>,
                <&kp LANG2 &kp N2 &kp LC(ENTER)>;

            label = "MC02";
        };

        mc03: mc03 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_pause_for_release>,
                <&kp LANG2 &kp N3 &kp LC(ENTER)>;

            label = "MC03";
        };

        mc04: mc04 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_pause_for_release>,
                <&kp LANG2 &kp MINUS &kp LC(ENTER)>;

            label = "MC04";
        };

        mc05: mc05 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_pause_for_release>,
                <&kp LANG2 &kp DOT &kp LC(ENTER)>;

            label = "MC05";
        };

        mc06: mc06 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_pause_for_release>,
                <&kp LA(LC(V)) &kp T &kp ENTER>;

            label = "MC06";
        };

        mc07: mc07 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_pause_for_release>,
                <&kp LA(LC(V)) &kp F &kp ENTER>;

            label = "MC07";
        };

        mc08: mc08 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_pause_for_release>,
                <&kp LA(LC(V)) &kp V &kp ENTER>;

            label = "MC08";
        };

        mc09: mc09 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_pause_for_release>, <&kp LA(H) &kp A &kp L>;

            label = "MC09";
        };

        mc10: mc10 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_pause_for_release>, <&kp LA(H) &kp A &kp C>;

            label = "MC10";
        };

        mc11: mc11 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_pause_for_release>, <&kp LA(H) &kp A &kp R>;

            label = "MC11";
        };

        iOS_00: iOS_00 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp GLOBE &kp UP_ARROW>,
                <&macro_release>;

            label = "IOS_00";
        };

        iOS_01: iOS_01 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press>, <&kp GLOBE &kp C>, <&macro_release>;

            label = "IOS_01";
        };

        iOS_02: iOS_02 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press>, <&kp GLOBE &kp LEFT>, <&macro_release>;

            label = "IOS_02";
        };

        iOS_03: iOS_03 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press>, <&kp GLOBE &kp RIGHT>, <&macro_release>;

            label = "IOS_03";
        };
    };

    combos {
        compatible = "zmk,combos";

        combo00 {
            bindings = <&kp ESC>;
            key-positions = <0 1>;
        };

        combo01 {
            bindings = <&kp TAB>;
            key-positions = <10 11>;
        };

        combo02 {
            bindings = <&kp CAPS>;
            key-positions = <20 21>;
        };

        combo03 {
            bindings = <&kp ENTER>;
            key-positions = <34 35>;
        };

        combo04 {
            bindings = <&none>;
            key-positions = <5 6>;
        };

        combo05 {
            bindings = <&us_bq>;
            key-positions = <6 7>;
        };

        combo06 {
