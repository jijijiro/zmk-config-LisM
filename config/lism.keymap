    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            bindings = <
&lt 2 Q      &lt 1 W  &lt 6 E     &kp R       &kp T                                        &trans       &kp Y        &lt 6 U     &lt 1 I     &lt 2 O
&lt 1 A      &lt 2 S  &mt LALT D  &mt LGUI F  &mt LCTRL G                                  &trans       &mt RCTRL H  &mt RGUI J  &mt RALT K  &kp P
&mt LSHFT Z  &lt 6 X  &kp C       &kp V       &kp B                                        &TD03        &TD04        &kp N       &lt 6 L     &mt RSHFT L
&trans       &trans   &trans      &kp UP      &lt 2 LANG2  &lt 1 SPACE    &lt 2 BACKSPACE  &lt 1 LANG1  &trans       &trans      &trans      &trans
                      &kp LEFT    &kp DOWN    &kp RIGHT                                    &trans       &trans       &trans
            >;
        };

        layer_1 {
            bindings = <
&mc05   &mc01      &mc02           &mc03           &TD14                                                 &kp HOME   &kp END            &kp N7       &kp N8       &lt 2 N9
&TD15   &TD16      &TD17           &TD18           &mt LCTRL LC(PAGE_DOWN)                               &kp PG_UP  &mt RCTRL PAGE_UP  &mt RGUI N4  &mt RALT N5  &kp N6
&TD20   &kp LC(X)  &kp LC(C)       &TD23           &kp LC(B)                                             &TD08      &kp N0             &kp N1       &kp N2       &mt RSHFT N3
&trans  &trans     &trans          &mmv MOVE_UP    &kp LG(L)                &kp LA(F4)    &kp BACKSPACE  &kp LANG2  &trans             &trans       &trans       &trans
                   &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT                                       &trans     &trans             &trans
            >;
        };

        layer_2 {
            bindings = <
&kp LA(LC(TAB))        &kp F1  &kp F2          &kp F3          &kp F4                                      &kp LC(T)          &kp LS(LC(TAB))  &kp UP    &kp LC(TAB)  &mt LS(F5) LC(W)
&kp LG(T)              &kp F5  &kp F6          &kp F7          &kp F8                                      &kp LA(LEFT)       &kp LEFT         &kp DOWN  &kp RIGHT    &kp F3
&mt LG(P) PRINTSCREEN  &kp F9  &kp F10         &kp F11         &kp F12                                     &kp LC(KP_MINUS)   &kp LC(KP_PLUS)  &kp F11   &trans       &trans
&trans                 &trans  &trans          &msc SCRL_UP    &TD28            &TD29    &kp LS(LG(LEFT))  &kp LS(LG(RIGHT))  &trans           &trans    &trans       &trans
                               &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_RIGHT                             &trans             &trans           &trans
            >;
        };

        layer_3 {
            bindings = <
&lt 5 Q      &lt 4 W      &lt 6 E     &kp R        &kp T                                        &trans       &kp Y       &lt 6 U      &lt 4 I     &lt 5 O
&lt 4 A      &mt GLOBE S  &mt LALT D  &mt LCTRL F  &mt LGUI G                                   &trans       &mt RGUI H  &mt RCTRL J  &mt RALT K  &mt GLOBE P
&mt LSHFT Z  &lt 6 X      &kp C       &kp V        &kp B                                        &TD03        &TD04       &kp N        &lt 6 L     &mt RSHFT L
&trans       &trans       &trans      &kp UP       &lt 2 LANG2  &lt 1 SPACE    &lt 2 BACKSPACE  &lt 1 LANG1  &trans      &trans       &trans      &trans
                          &kp LEFT    &kp DOWN     &kp RIGHT                                    &trans       &trans      &trans
            >;
        };

        layer_4 {
            bindings = <
&trans           &trans           &trans          &trans          &trans                                       &kp HOME   &kp END             &kp N7        &kp N8       &lt 5 N9
&kp LG(A)        &mt GLOBE LG(S)  &mt LALT LG(D)  &kp LCTRL       &kp LGUI                                     &kp PG_UP  &mt RGUI PAGE_DOWN  &mt RCTRL N4  &mt RALT N5  &mt GLOBE N6
&mt LSHFT LG(Z)  &kp LG(X)        &kp LG(C)       &kp LG(V)       &kp LG(B)                                    &TD08      &kp N0              &kp N1        &kp N2       &mt RSHFT N3
&trans           &trans           &trans          &mmv MOVE_UP    &kp LG(LC(Q))    &kp LG(H)    &kp BACKSPACE  &kp LANG2  &trans              &trans        &trans       &trans
                                  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT                              &trans     &trans              &trans
            >;
        };

        layer_5 {
            bindings = <
&iOS_00                    &kp F1  &kp F2          &kp F3          &kp F4                                    &kp LG(T)              &kp LC(LS(TAB))  &kp UP    &kp LC(TAB)  &mt LG(R) LG(W)
&iOS_01                    &kp F5  &kp F6          &kp F7          &kp F8                                    &kp LG(RIGHT_BRACKET)  &kp LEFT         &kp DOWN  &kp RIGHT    &kp F3
&mt LG(LS(N3)) LG(LS(N4))  &kp F9  &kp F10         &kp F11         &kp F12                                   &kp LG(KP_MINUS)       &kp LG(KP_PLUS)  &trans    &trans       &trans
&trans                     &trans  &trans          &msc SCRL_UP    &iOS_02          &iOS_03    &kp LG(LEFT)  &kp LG(RIGHT)          &trans           &trans    &trans       &trans
                                   &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_RIGHT                           &trans                 &trans           &trans
            >;
        };

        layer_6 {
            bindings = <
&trans  &trans  &trans        &mc2          &mc3                        &mc3    &mc2          &kp LS(N6)  &kp LS(N8)        &kp LS(N9)
