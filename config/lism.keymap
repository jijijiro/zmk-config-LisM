        };

        layer_8 {
            bindings = <
&BT00         &BT01   &BT02         &BT03         &BT04                                       &trans        &trans    &trans    &trans  &studio_unlock
&out OUT_USB  &trans  &kp LALT      &kp LGUI      &bootloader                                 &bootloader   &kp RGUI  &kp RALT  &trans  &trans
&kp LSHFT     &trans  &trans        &trans        &kp LCTRL                                   &kp RCTRL     &trans    &trans    &trans  &kp RSHFT
&trans        &trans  &trans        &kp C_VOL_UP  &kp C_VOL_DN  &kp C_VOL_UP    &kp C_BRI_DN  &kp C_BRI_UP  &trans    &trans    &trans  &trans
                      &kp C_BRI_DN  &kp C_VOL_DN  &kp C_BRI_UP                                &trans        &trans    &trans
            >;

            sensor-bindings = <&encoder_msc SCRL_LEFT SCRL_RIGHT>;
        };

        layer_9 {
            bindings = <
&trans  &trans  &trans  &trans  &trans                       &trans     &trans        &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans                       &trans     &DoubleClick  &mkp MB1  &mkp MB2  &trans
&trans  &trans  &trans  &trans  &kp LCTRL                    &kp RCTRL  &trans        &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans     &trans    &trans  &trans     &trans        &trans    &trans    &trans
                &trans  &trans  &trans                       &trans     &trans        &trans
            >;
        };
    };
};
