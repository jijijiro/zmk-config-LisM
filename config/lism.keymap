        };

        TD28: TD28 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD28";
            #binding-cells = <0>;
            bindings = <&kp LC(LG(LEFT))>, <&kp LA(LC(LG(LEFT)))>;

            tapping-term-ms = <300>;
        };

        TD29: TD29 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD29";
            #binding-cells = <0>;
            bindings = <&kp LC(LG(RIGHT))>, <&kp LA(LC(LG(RIGHT)))>;

            tapping-term-ms = <300>;
        };

        TD30: TD30 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD30";
            #binding-cells = <0>;
