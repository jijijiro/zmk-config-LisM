#define ZMK_POINTING_DEFAULT_SCRL_VAL 20

#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
    tapping-term-ms = <300>;
    flavor = "balanced";
    require-prior-idle-ms = <200>;
};

&lt {
    tapping-term-ms = <300>;
    require-prior-idle-ms = <200>;
};

/ {
    behaviors {
        encoder_msc: sensor_rotate_msc {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;

            tap-ms = <20>;
        };

        encoder_kp: sensor_rotate_kp {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&kp>, <&kp>;
        };

        us00_bq: us00_bq {
            compatible = "zmk,behavior-mod-morph";
            label = "US00_BQ";
            bindings = <&kp LS(LEFT_BRACKET)>, <&kp LS(EQUAL)>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        us01_min: us01_min {
            compatible = "zmk,behavior-mod-morph";
            label = "US01_MIN";
            bindings = <&kp MINUS>, <&kp LS(INT1)>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        us02_eq: us02_eq {
            compatible = "zmk,behavior-mod-morph";
            label = "US02_EQ";
            bindings = <&kp LS(MINUS)>, <&kp LS(SEMI)>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        us03_se: us03_se {
            compatible = "zmk,behavior-mod-morph";
            label = "US03_SE";
            bindings = <&kp SEMI>, <&kp APOS>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        us04_ap: us04_ap {
            compatible = "zmk,behavior-mod-morph";
            label = "US04_AP";
            bindings = <&kp LS(N7)>, <&kp LS(N2)>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        TD00: TD00 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD00";
            #binding-cells = <0>;
            bindings = <&us01_min>, <&us02_eq>;

            tapping-term-ms = <300>;
        };

        TD01: TD01 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD01";
            #binding-cells = <0>;
            bindings = <&kp COMMA>, <&us04_ap>;

            tapping-term-ms = <300>;
        };

        TD02: TD02 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD02";
            #binding-cells = <0>;
            bindings = <&kp DOT>, <&us03_se>;

            tapping-term-ms = <300>;
        };

        TD03: TD03 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD03";
            #binding-cells = <0>;
            bindings = <&mt RSHFT SLASH>, <&kp INT3>;

            tapping-term-ms = <300>;
        };

        TD04: TD04 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD04";
            #binding-cells = <0>;
            bindings = <&kp KP_ASTERISK>, <&kp HOME>;

            tapping-term-ms = <300>;
        };

        TD05: TD05 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD05";
            #binding-cells = <0>;
            bindings = <&lt 2 KP_SLASH>, <&kp END>;

            tapping-term-ms = <300>;
        };

        TD06: TD06 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD06";
            #binding-cells = <0>;
            bindings = <&mt GLOBE KP_PLUS>, <&kp PAGE_UP>;

            tapping-term-ms = <300>;
        };

        TD07: TD07 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD07";
            #binding-cells = <0>;
            bindings = <&kp KP_MINUS>, <&kp PAGE_DOWN>;

            tapping-term-ms = <300>;
        };

        TD08: TD08 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD08";
            #binding-cells = <0>;
            bindings = <&mt COMMA DOT>, <&us03_se>;

            tapping-term-ms = <300>;
        };

        TD09: TD09 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD09";
            #binding-cells = <0>;
            bindings = <&mt RSHFT ENTER>, <&kp TAB>;

            tapping-term-ms = <300>;
        };

        TD10: TD10 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD10";
            #binding-cells = <0>;
            bindings = <&none>;
            tapping-term-ms = <300>;
        };

        TD11: TD11 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD11";
            #binding-cells = <0>;
            bindings = <&mc02>, <&kp LS(LC(F1))>;

            tapping-term-ms = <300>;
        };

        TD12: TD12 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD12";
            #binding-cells = <0>;
            bindings = <&none>;
            tapping-term-ms = <300>;
        };

        TD13: TD13 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD13";
            #binding-cells = <0>;
            bindings = <&none>;
            tapping-term-ms = <300>;
        };

        TD14: TD14 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD14";
            #binding-cells = <0>;
            bindings = <&mc05>, <&mc06>;

            tapping-term-ms = <300>;
        };

        TD15: TD15 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD15";
            #binding-cells = <0>;
            bindings = <&kp LC(A)>, <&mc09>;

            tapping-term-ms = <300>;
        };

        TD16: TD16 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD16";
            #binding-cells = <0>;
            bindings = <&kp LC(S)>, <&mc10>;

            tapping-term-ms = <300>;
        };

        TD17: TD17 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD17";
            #binding-cells = <0>;
            bindings = <&mt LC(LALT) LC(D)>, <&mc11>;

            tapping-term-ms = <300>;
        };

        TD18: TD18 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD18";
            #binding-cells = <0>;
            bindings = <&mt LGUI LC(PAGE_UP)>, <&mc07>;

            tapping-term-ms = <300>;
        };

        TD19: TD19 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD19";
            #binding-cells = <0>;
            bindings = <&none>;
            tapping-term-ms = <300>;
        };

        TD20: TD20 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD20";
            #binding-cells = <0>;
            bindings = <&mt LSHFT LC(Z)>, <&kp LC(N1)>;

            tapping-term-ms = <300>;
        };

        TD21: TD21 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD21";
            #binding-cells = <0>;
            bindings = <&kp LC(X)>, <&kp LA(LC(KP_MINUS))>;

            tapping-term-ms = <300>;
        };

        TD22: TD22 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD22";
            #binding-cells = <0>;
            bindings = <&kp LC(C)>, <&kp LA(LC(KP_PLUS))>;

            tapping-term-ms = <300>;
        };

        TD23: TD23 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD23";
            #binding-cells = <0>;
            bindings = <&kp LC(V)>, <&mc08>;

            tapping-term-ms = <300>;
        };

        TD24: TD24 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD24";
            #binding-cells = <0>;
            bindings = <&none>;
            tapping-term-ms = <300>;
        };

        TD25: TD25 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD25";
            #binding-cells = <0>;
            bindings = <&none>;
            tapping-term-ms = <300>;
        };

        TD26: TD26 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD26";
            #binding-cells = <0>;
            bindings = <&none>;
            tapping-term-ms = <300>;
        };

        TD27: TD27 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD27";
            #binding-cells = <0>;
            bindings = <&none>;
            tapping-term-ms = <300>;
        };

        TD28: TD28 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD28";
            #binding-cells = <0>;
            bindings = <&kp LC(LG(LEFT))>, <&kp LA(LC(LG(LEFT)))>;

            tapping-term-ms = <300>;
        };

        TD29: TD29 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD29";
            #binding-cells = <0>;
            bindings = <&kp LC(LG(RIGHT))>, <&kp LA(LC(LG(RIGHT)))>;

            tapping-term-ms = <300>;
        };

        TD30: TD30 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD30";
            #binding-cells = <0>;
            bindings = <&none>;
            tapping-term-ms = <300>;
        };

        TD31: TD31 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD31";
            #binding-cells = <0>;
            bindings = <&none>;
            tapping-term-ms = <300>;
        };
    };

    macros {
        bt00: bt00 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&out OUT_BLE &bt BT_SEL 0 &to 0>;
            label = "BT00";
        };

        bt01: bt01 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&out OUT_BLE &bt BT_SEL 1 &to 0>;
            label = "BT01";
        };

        bt02: bt02 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&out OUT_BLE &bt BT_SEL 2 &to 3>;
            label = "BT02";
        };

        bt03: bt03 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&out OUT_BLE &bt BT_SEL 3 &to 0>;
            label = "BT03";
        };

        bt04: bt04 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&out OUT_BLE &bt BT_SEL 4 &to 0>;
            label = "BT04";
        };

        mc00: mc00 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(N8) &kp LS(N9) &kp LEFT>;
            label = "MC00";
        };

        mc01: mc01 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_pause_for_release>,
                <&kp LANG2 &kp N1 &kp LC(ENTER)>;

            label = "MC01";
        };

        mc02: mc02 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_pause_for_release>,
                <&kp LANG2 &kp N2 &kp LC(ENTER)>;

            label = "MC02";
        };

        mc03: mc03 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_pause_for_release>,
                <&kp LANG2 &kp N3 &kp LC(ENTER)>;

            label = "MC03";
        };

        mc04: mc04 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_pause_for_release>,
                <&kp LANG2 &kp MINUS &kp LC(ENTER)>;

            label = "MC04";
        };

        mc05: mc05 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_pause_for_release>,
                <&kp LANG2 &kp DOT &kp LC(ENTER)>;

            label = "MC05";
        };

        mc06: mc06 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_pause_for_release>,
                <&kp LA(LC(V)) &kp T &kp ENTER>;

            label = "MC06";
        };

        mc07: mc07 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_pause_for_release>,
                <&kp LA(LC(V)) &kp F &kp ENTER>;

            label = "MC07";
        };

        mc08: mc08 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_pause_for_release>,
                <&kp LA(LC(V)) &kp V &kp ENTER>;

            label = "MC08";
        };

        mc09: mc09 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LA(H) &kp A &kp L>;
            label = "MC09";
        };

        mc10: mc10 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LA(H) &kp A &kp C>;
            label = "MC10";
        };

        mc11: mc11 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LA(H) &kp A &kp R>;
            label = "MC11";
        };

        iOS00: iOS00 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp GLOBE &kp H>,
                <&macro_release>,
                <&kp GLOBE>;

            label = "IOS00";
        };

        iOS01: iOS01 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp GLOBE &kp UP>,
                <&macro_release>,
                <&kp GLOBE>;

            label = "IOS01";
        };

        iOS02: iOS02 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp GLOBE &kp C>,
                <&macro_release>,
                <&kp GLOBE>;

            label = "IOS02";
        };

        iOS03: iOS03 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp GLOBE &kp LEFT>,
                <&macro_release>,
                <&kp GLOBE>;

            label = "IOS03";
        };

        iOS04: iOS04 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp GLOBE &kp RIGHT>,
                <&macro_release>,
                <&kp GLOBE>;

            label = "IOS04";
        };
    };

    combos {
        compatible = "zmk,combos";

        combo00 {
            bindings = <&kp ESC>;
            key-positions = <0 1>;
        };

        combo01 {
            bindings = <&kp TAB>;
            key-positions = <10 11>;
        };

        combo02 {
            bindings = <&kp ENTER>;
            key-positions = <34 35>;
        };

        combo03 {
            bindings = <&kp ESC>;
            key-positions = <8 9>;
        };

        combo04 {
            bindings = <&kp TAB>;
            key-positions = <36 37>;
        };

        combo05 {
            bindings = <&kp DEL>;
            key-positions = <0 10>;
        };

        combo06 {
            bindings = <&kp BACKSPACE>;
            key-positions = <10 20>;
        };

        combo07 {
            bindings = <&mkp MB1>;
            key-positions = <1 11>;
        };

        combo08 {
            bindings = <&mkp MB2>;
            key-positions = <2 12>;
        };

        combo09 {
            bindings = <&mkp MB1>;
            key-positions = <7 17>;
        };

        combo10 {
            bindings = <&mkp MB2>;
            key-positions = <8 18>;
        };

        combo11 {
            bindings = <&kp DEL>;
            key-positions = <9 19>;
        };

        combo12 {
            bindings = <&kp ENTER>;
            key-positions = <19 29>;
        };

        combo13 {
            bindings = <&kp HOME>;
            key-positions = <3 4>;
        };

        combo14 {
            bindings = <&kp END>;
            key-positions = <13 14>;
        };

        combo15 {
            bindings = <&kp PAGE_UP>;
            key-positions = <3 13>;
        };

        combo16 {
            bindings = <&kp PAGE_DOWN>;
            key-positions = <4 14>;
        };

        combo17 {
            bindings = <&kp UP>;
            key-positions = <12 13>;
        };

        combo18 {
            bindings = <&kp DOWN>;
            key-positions = <22 23>;
        };

        combo19 {
            bindings = <&kp LEFT>;
            key-positions = <12 22>;
        };

        combo20 {
            bindings = <&kp RIGHT>;
            key-positions = <13 23>;
        };

        combo21 {
            bindings = <&kp UP>;
            key-positions = <16 17>;
        };

        combo22 {
            bindings = <&kp DOWN>;
            key-positions = <26 27>;
        };

        combo23 {
            bindings = <&kp LEFT>;
            key-positions = <16 26>;
        };

        combo24 {
            bindings = <&kp RIGHT>;
            key-positions = <17 27>;
        };

        combo25 {
            bindings = <&mc00>;
            key-positions = <15 16>;
        };

        combo26 {
            bindings = <&bootloader>;
            key-positions = <20 21 22>;
            layers = <6>;
        };

        combo27 {
            bindings = <&bootloader>;
            key-positions = <27 28 29>;
            layers = <6>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            bindings = <
&lt 2 Q      &lt 1 W  &kp E       &kp R       &lt 6 T                                      &lt 6 Y      &kp U       &kp I       &lt 1 O  &lt 2 P
&lt 1 A      &lt 6 S  &mt LALT D  &mt LGUI F  &mt LCTRL G                                  &mt RCTRL H  &mt RGUI J  &mt RALT K  &kp L    &TD00
&mt LSHFT Z  &lt 6 X  &mt CAPS C  &kp V       &kp B                                        &mt LANG2 N  &kp M       &TD01       &TD02    &TD03
&trans       &trans   &trans      &kp UP      &lt 2 LANG2  &lt 1 SPACE    &lt 1 BACKSPACE  &lt 2 LANG1  &trans      &trans      &trans   &trans
                      &kp LEFT    &kp DOWN    &kp RIGHT                                    &trans       &trans      &trans
            >;
        };

        layer_1 {
            bindings = <
&mc01   &TD11   &mc03           &mc04           &TD14                                            &kp N7        &kp N8       &kp N9       &TD04   &TD05
&TD15   &TD16   &TD17           &TD18           &mt LCTRL LC(PAGE_DOWN)                          &mt RCTRL N4  &mt RGUI N5  &mt RALT N6  &TD06   &TD07
&TD20   &TD21   &TD22           &TD23           &kp LC(B)                                        &kp N1        &kp N2       &kp N3       &TD08   &TD09
&trans  &trans  &trans          &mmv MOVE_UP    &kp LG(L)                &kp LA(F4)    &kp BSPC  &kp N0        &trans       &trans       &trans  &trans
                &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT                                  &trans        &trans       &trans
            >;
        };

        layer_2 {
            bindings = <
&kp LA(LC(TAB))        &kp F1  &kp F2          &kp F3          &kp F4                                      &kp LC(L)          &kp LC(LS(O))    &kp HOME          &mt LG(L) LC(T)  &mt LA(F4) LC(W)
&kp LG(A)              &kp F5  &kp F6          &kp F7          &kp F8                                      &kp LA(LEFT)       &kp LS(LC(TAB))  &kp END           &kp LC(TAB)      &kp LC(R)
&mt LG(P) PRINTSCREEN  &kp F9  &kp F10         &kp F11         &kp F12                                     &kp LC(F)          &kp LC(G)        &kp LC(KP_MINUS)  &kp LC(KP_PLUS)  &kp F11
&trans                 &trans  &trans          &msc SCRL_UP    &TD28            &TD29    &kp LS(LG(LEFT))  &kp LS(LG(RIGHT))  &trans           &trans            &trans           &trans
                               &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_RIGHT                             &trans             &trans           &trans
            >;
        };

        layer_3 {
            bindings = <
&lt 5 Q      &lt 4 W      &kp E       &kp R        &lt 6 T                                      &lt 6 Y      &kp U        &kp I       &lt 4 O      &lt 5 P
&lt 4 A      &mt GLOBE S  &mt LALT D  &mt LCTRL F  &mt LGUI G                                   &mt RGUI H   &mt RCTRL J  &mt RALT K  &mt GLOBE L  &TD00
&mt LSHFT Z  &lt 6 X      &mt CAPS C  &kp V        &kp B                                        &mt LANG2 N  &kp M        &TD01       &TD02        &TD03
&trans       &trans       &trans      &kp UP       &lt 5 LANG2  &lt 4 SPACE    &lt 4 BACKSPACE  &lt 5 LANG1  &trans       &trans      &trans       &trans
                          &kp LEFT    &kp DOWN     &kp RIGHT                                    &trans       &trans       &trans
            >;
        };

        layer_4 {
            bindings = <
&trans     &trans           &trans          &trans          &trans                               &kp N7       &kp N8        &kp N9       &TD04   &TD05
&kp LG(A)  &mt GLOBE LG(S)  &mt LALT LG(D)  &kp LCTRL       &kp LGUI                             &mt RGUI N4  &mt RCTRL N5  &mt RALT N6  &TD06   &TD07
&kp LG(Z)  &kp LG(X)        &kp LG(C)       &kp LG(V)       &kp LG(B)                            &kp N1       &kp N2        &kp N3       &TD08   &TD09
&trans     &trans           &trans          &mmv MOVE_UP    &kp LG(LC(Q))    &iOS00    &kp BSPC  &kp N0       &trans        &trans       &trans  &trans
                            &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT                      &trans       &trans        &trans
            >;
        };

        layer_5 {
            bindings = <
&iOS01                     &kp F1  &kp F2          &kp F3          &kp F4                                   &kp LG(L)              &kp LA(LG(B))    &kp LG(UP)    &mt LG(LC(Q)) LG(T)  &mt LG(H) LG(W)
&iOS02                     &kp F5  &kp F6          &kp F7          &kp F8                                   &kp LG(RIGHT_BRACKET)  &kp LS(LC(TAB))  &kp LG(DOWN)  &kp LC(TAB)          &kp LG(R)
&mt LG(LS(N3)) LG(LS(N4))  &kp F9  &kp F10         &kp F11         &kp F12                                  &kp LG(F)              &kp LG(G)        &trans        &trans               &trans
&trans                     &trans  &trans          &msc SCRL_UP    &iOS03           &iOS04    &kp LG(LEFT)  &kp LG(RIGHT)          &trans           &trans        &trans               &trans
                                   &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_RIGHT                          &trans                 &trans           &trans
            >;
        };

        layer_6 {
            bindings = <
&out OUT_USB  &bt04   &bt03         &bt02         &trans                        &kp LS(N6)  &kp LS(N8)        &kp LS(N9)  &kp LS(RIGHT_BRACKET)  &kp LS(NON_US_HASH)
&kp LG(T)     &trans  &trans        &trans        &trans                        &kp LS(N4)  &kp LS(N5)        &kp EQUAL   &kp RIGHT_BRACKET      &kp NON_US_HASH
&trans        &trans  &trans        &trans        &trans                        &kp LS(N1)  &kp LEFT_BRACKET  &kp LS(N3)  &kp LS(LEFT_BRACKET)   &kp LS(EQUAL)
&trans        &trans  &trans        &kp C_VOL_UP  &bt01         &bt00    &bt00  &bt02       &trans            &trans      &trans                 &trans
                      &kp C_BRI_DN  &kp C_VOL_DN  &kp C_BRI_UP                  &trans      &trans            &trans
            >;
        };
    };
};
