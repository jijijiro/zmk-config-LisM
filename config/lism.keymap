&mt LSHFT F11  &kp F12  &kp LG(LS(N4))  &trans          &kp LGUI                                  &mt (RGUI) LS(N1)  &kp LBKT            &kp LS(N3)         &kp LS(LBKT)  &mt (RSHFT) LS(EQUAL)
&trans         &trans   &trans          &mmv MOVE_UP    &kp LG(LEFT)     &kp LG(RIGHT)    &iOS04  &iOS05             &trans              &trans             &trans        &trans
                        &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT                           &trans             &trans              &trans
            >;

            sensor-bindings = <&inc_dec_kp UP DOWN>;
        };

        layer_7 {
