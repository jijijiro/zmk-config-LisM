        TD09: TD09 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD09";
            #binding-cells = <0>;
            bindings = <&kp KP_MINUS>, <&kp KP_SLASH>;

            tapping-term-ms = <300>;
        };

        TD10: TD10 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD10";
            #binding-cells = <0>;
            bindings = <&mc01>, <&mc09>;

            tapping-term-ms = <300>;
        };

        TD11: TD11 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD11";
            #binding-cells = <0>;
            bindings = <&mc02>, <&mc10>;

            tapping-term-ms = <300>;
        };

        TD12: TD12 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD12";
            #binding-cells = <0>;
            bindings = <&mc03>, <&mc11>;

            tapping-term-ms = <300>;
        };

        TD13: TD13 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD13";
            #binding-cells = <0>;
            bindings = <&none>;
