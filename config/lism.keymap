#define ZMK_POINTING_DEFAULT_SCRL_VAL 20

#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
    tapping-term-ms = <300>;
    flavor = "balanced";
    require-prior-idle-ms = <200>;
};

&lt {
    tapping-term-ms = <300>;
    require-prior-idle-ms = <200>;
};

/ {
    behaviors {
        encoder_msc: sensor_rotate_msc {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;

            tap-ms = <20>;
        };

        encoder_kp: sensor_rotate_kp {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&kp>, <&kp>;
        };

        us_eq: us_eq {
            compatible = "zmk,behavior-mod-morph";
            label = "US_EQ";
            bindings = <&kp LS(MINUS)>, <&kp LS(SEMI)>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        us_min: us_min {
            compatible = "zmk,behavior-mod-morph";
            label = "US_MIN";
            bindings = <&kp MINUS>, <&kp LS(INT1)>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        TD00: TD00 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD00";
            #binding-cells = <0>;
            bindings = <&none>;
            tapping-term-ms = <300>;
        };

        TD01: TD01 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD01";
            #binding-cells = <0>;
            bindings = <&none>;
            tapping-term-ms = <300>;
        };

        TD02: TD02 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD02";
            #binding-cells = <0>;
            bindings = <&none>;
            tapping-term-ms = <300>;
        };

        TD03: TD03 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD03";
            #binding-cells = <0>;
            bindings = <&us_eq>, <&kp LS(APOS)>;

            tapping-term-ms = <300>;
        };

        TD04: TD04 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD04";
            #binding-cells = <0>;
            bindings = <&us_min>, <&kp SLASH>;

            tapping-term-ms = <300>;
        };

        TD05: TD05 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD05";
            #binding-cells = <0>;
            bindings = <&kp COMMA>, <&kp LS(N7)>;

            tapping-term-ms = <300>;
        };

        TD06: TD06 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD06";
            #binding-cells = <0>;
            bindings = <&kp DOT>, <&kp APOS>;

            tapping-term-ms = <300>;
        };

        TD07: TD07 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD07";
            #binding-cells = <0>;
            bindings = <&kp SLASH>, <&kp LS(N1)>;

            tapping-term-ms = <300>;
        };

        TD08: TD08 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD08";
            #binding-cells = <0>;
            bindings = <&kp KP_PLUS>, <&kp KP_ASTERISK>;

            tapping-term-ms = <300>;
