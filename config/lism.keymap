        };

        TD31: TD31 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD31";
            #binding-cells = <0>;
            bindings = <&none>;
            tapping-term-ms = <300>;
        };

        TD000: TD000 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD000";
            #binding-cells = <0>;
            bindings = <&none>;
            tapping-term-ms = <300>;
        };

        TD001: TD001 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD001";
            #binding-cells = <0>;
            bindings = <&none>;
            tapping-term-ms = <300>;
        };

        TD002: TD002 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD002";
            #binding-cells = <0>;
            bindings = <&none>;
            tapping-term-ms = <300>;
        };

        TD003: TD003 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD003";
            #binding-cells = <0>;
            bindings = <&none>;
            tapping-term-ms = <300>;
        };

        TD004: TD004 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD004";
            #binding-cells = <0>;
            bindings = <&none>;
            tapping-term-ms = <300>;
        };
    };

    macros {
        mc00: mc00 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none>;
            label = "MC00";
        };

        mc01: mc01 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_pause_for_release>,
                <&kp LANG2 &kp N1 &kp LC(ENTER)>;

            label = "MC01";
        };

        mc02: mc02 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_pause_for_release>,
                <&kp LANG2 &kp N2 &kp LC(ENTER)>;

            label = "MC02";
        };

        mc03: mc03 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_pause_for_release>,
                <&kp LANG2 &kp N3 &kp LC(ENTER)>;

            label = "MC03";
        };

        mc04: mc04 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_pause_for_release>,
                <&kp LANG2 &kp MINUS &kp LC(ENTER)>;

            label = "MC04";
        };

        mc05: mc05 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_pause_for_release>,
                <&kp LANG2 &kp DOT &kp LC(ENTER)>;

            label = "MC05";
        };

        mc06: mc06 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_pause_for_release>,
                <&kp LA(LC(V)) &kp T &kp ENTER>;

            label = "MC06";
        };

        mc07: mc07 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_pause_for_release>,
                <&kp LA(LC(V)) &kp F &kp ENTER>;

            label = "MC07";
        };

        mc08: mc08 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_pause_for_release>,
                <&kp LA(LC(V)) &kp V &kp ENTER>;

            label = "MC08";
        };

        mc09: mc09 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LA(H) &kp A &kp L>;
            label = "MC09";
        };

        mc10: mc10 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LA(H) &kp A &kp C>;
            label = "MC10";
        };

        mc11: mc11 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LA(H) &kp A &kp R>;
            label = "MC11";
        };

        mc001: mc001 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LANG1 &kp LS(N8) &kp LS(N9) &kp LEFT>;
            label = "MC001";
        };

        mc002: mc002 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LANG2 &kp LS(N8) &kp LS(N9) &kp LEFT>;
            label = "MC002";
        };
    };

    combos {
        compatible = "zmk,combos";

        combo00 {
            bindings = <&kp ESC>;
            key-positions = <0 1>;
        };

        combo01 {
            bindings = <&kp TAB>;
            key-positions = <10 11>;
        };

        combo02 {
            bindings = <&mo 2>;
            key-positions = <20 21>;
        };

        combo03 {
            bindings = <&none>;
            key-positions = <34 35>;
        };

        combo04 {
            bindings = <&none>;
            key-positions = <8 9>;
        };

        combo05 {
            bindings = <&none>;
            key-positions = <18 19>;
        };

        combo06 {
            bindings = <&mc001>;
            key-positions = <17 18>;
        };

        combo07 {
            bindings = <&mc002>;
            key-positions = <16 17>;
        };

        combo08 {
            bindings = <&none>;
            key-positions = <36 37>;
        };

        combo09 {
            bindings = <&kp DEL>;
            key-positions = <0 10>;
        };

        combo10 {
            bindings = <&mkp MB1>;
            key-positions = <1 11>;
        };

        combo11 {
            bindings = <&mkp MB2>;
            key-positions = <2 12>;
        };

        combo12 {
            bindings = <&kp BACKSPACE>;
            key-positions = <10 20>;
        };

        combo13 {
            bindings = <&kp ENTER>;
            key-positions = <20 30>;
        };

        combo14 {
            bindings = <&mkp MB1>;
            key-positions = <7 17>;
        };

        combo15 {
            bindings = <&mkp MB2>;
            key-positions = <18 8>;
        };

        combo16 {
            bindings = <&kp DEL>;
            key-positions = <9 19>;
        };

        combo17 {
            bindings = <&kp BACKSPACE>;
            key-positions = <19 29>;
        };

        combo18 {
            bindings = <&kp ENTER>;
            key-positions = <29 41>;
        };

        combo19 {
            bindings = <&kp UP>;
            key-positions = <13 14>;
        };

        combo20 {
            bindings = <&kp DOWN>;
            key-positions = <23 24>;
        };

        combo21 {
            bindings = <&kp LEFT>;
            key-positions = <13 23>;
        };

        combo22 {
            bindings = <&kp RIGHT>;
            key-positions = <14 24>;
        };

        combo23 {
            bindings = <&bt BT_CLR>;
            key-positions = <8 9>;
            layers = <5>;
        };

        combo24 {
            bindings = <&bt BT_CLR_ALL>;
            key-positions = <8 9 7>;
            layers = <5>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            bindings = <
&lt 5 Q      &lt 4 W      &lt 3 E         &kp R           &kp T                                      &trans           &kp Y        &lt 3 U      &lt 4 I  &lt 5 O
&lt 2 A      &lt 1 S      &kp D           &mt LANG2 F     &mt LANG1 G                                &trans           &mt LANG2 H  &mt LANG1 J  &lt 1 K  &lt 2 P
&mt LSHFT Z  &mt RSHFT X  &kp C           &kp V           &kp B                                      &TD03            &TD04        &kp N        &kp M    &mt RSHFT L
&kp LCTRL    &kp LGUI     &mt LALT CAPS   &mmv MOVE_UP    &lt 2 ENTER      &lt 1 SPACE    &lt 3 TAB  &lt 4 BACKSPACE  &trans       &TD05        &TD06    &TD07
                          &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT                            &trans           &trans       &trans
            >;

            sensor-bindings = <&encoder_kp LEFT RIGHT>;
        };

        layer_1 {
            bindings = <
&TD10           &TD11    &TD12            &mc04         &TD14                               &kp HOME   &kp END    &kp N7  &kp N8  &kp N9
&kp LS(LC(F1))  &kp F2   &kp F3           &TD18         &kp F5                              &kp PG_UP  &kp PG_DN  &kp N4  &kp N5  &kp N6
&kp F6          &kp F7   &kp F8           &TD23         &kp F10                             &TD08      &TD09      &kp N1  &kp N2  &kp N3
&kp F11         &kp F12  &kp PRINTSCREEN  &kp LS(UP)    &kp LGUI       &kp LALT    &kp TAB  &kp BSPC   &trans     &kp N0  &TD06   &kp TAB
                         &kp LS(LEFT)     &kp LS(DOWN)  &kp LS(RIGHT)                       &trans     &trans     &trans
            >;

            sensor-bindings = <&encoder_kp C_BRI_DN C_BRI_UP>;
        };

        layer_2 {
            bindings = <
&kp N7  &kp N8  &kp N9    &kp HOME   &kp END                          &kp LS(RIGHT_BRACKET)  &kp LS(NON_US_HASH)  &kp LS(N6)            &kp LS(N8)        &kp LS(N9)
&kp N4  &kp N5  &kp N6    &kp PG_UP  &kp PG_DN                        &kp RIGHT_BRACKET      &kp NON_US_HASH      &kp LS(N4)            &kp LS(N5)        &kp EQUAL
&kp N1  &kp N2  &kp N3    &TD09      &TD08                            &kp LS(INT3)           &kp LS(EQUAL)        &kp LS(LEFT_BRACKET)  &kp LEFT_BRACKET  &kp LS(N3)
&kp N0  &TD06   &kp TAB   &kp UP     &kp LSHFT  &kp LCTRL    &kp TAB  &kp BSPC               &trans               &kp LS(N7)            &kp SEMI          &kp INT3
                &kp LEFT  &kp DOWN   &kp RIGHT                        &trans                 &trans               &trans
            >;

            sensor-bindings = <&encoder_kp C_VOL_DN C_VOL_UP>;
        };

        layer_3 {
            bindings = <
&kp LA(LC(TAB))  &TD28   &trans        &TD29         &kp LG(T)                                      &kp LC(T)         &kp LS(LC(TAB))  &kp UP    &kp LC(TAB)  &kp LC(W)
&trans           &trans  &trans        &trans        &trans                                         &kp LA(LEFT)      &kp LEFT         &kp DOWN  &kp RIGHT    &kp LS(F5)
&trans           &trans  &trans        &trans        &trans                                         &kp LC(KP_MINUS)  &kp LC(KP_PLUS)  &trans    &trans       &trans
&kp LG(P)        &trans  &trans        &kp C_VOL_UP  &kp LS(LG(LEFT))  &kp LS(LG(RIGHT))    &trans  &trans            &trans           &trans    &trans       &trans
                         &kp C_BRI_DN  &kp C_VOL_DN  &kp C_BRI_UP                                   &trans            &trans           &trans
            >;

            sensor-bindings = <&encoder_msc SCRL_LEFT SCRL_RIGHT>;
        };

        layer_4 {
            bindings = <
&trans  &trans  &trans  &trans  &trans                    &kp HOME   &kp END    &kp N7  &kp N8  &kp N9
&trans  &trans  &trans  &trans  &trans                    &kp PG_UP  &kp PG_DN  &kp N4  &kp N5  &kp N6
&trans  &trans  &trans  &trans  &trans                    &TD08      &TD09      &kp N1  &kp N2  &kp N3
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans     &trans     &kp N0  &TD06   &kp TAB
                &trans  &trans  &trans                    &trans     &trans     &trans
            >;

            sensor-bindings = <&encoder_msc SCRL_UP SCRL_DOWN>;
        };

        layer_5 {
            bindings = <
&trans       &bt BT_SEL 0    &bt BT_SEL 1    &bt BT_SEL 2    &bt BT_SEL 3                               &bt BT_SEL 3  &bt BT_SEL 2  &bt BT_SEL 1  &bt BT_SEL 0    &trans
&trans       &trans          &trans          &out OUT_USB    &bt BT_SEL 4                               &bt BT_SEL 4  &out OUT_USB  &trans        &trans          &trans
&sys_reset   &trans          &trans          &trans          &trans                                     &trans        &trans        &trans        &trans          &sys_reset
&bootloader  &studio_unlock  &kp LG(L)       &msc SCRL_UP    &kp LG(D)        &kp LA(F4)    &kp LA(F4)  &kp LG(D)     &trans        &kp LG(L)     &studio_unlock  &bootloader
                             &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_RIGHT                            &trans        &trans        &trans
            >;

            sensor-bindings = <&inc_dec_kp UP DOWN>;
        };
    };
};
