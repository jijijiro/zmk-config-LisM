            tapping-term-ms = <300>;
        };

        TD003: TD003 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD003";
            #binding-cells = <0>;
            bindings = <&none>;
            tapping-term-ms = <300>;
        };

        TD004: TD004 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD004";
            #binding-cells = <0>;
            bindings = <&none>;
            tapping-term-ms = <300>;
        };
    };

    macros {
        mc00: mc00 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(N8) &kp LS(N9) &kp LEFT>;
            label = "MC00";
        };

        mc01: mc01 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&kp LANG2 &kp N1 &kp LC(ENTER)>,
                <&macro_pause_for_release>;

            label = "MC01";
        };

        mc02: mc02 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&kp LANG2 &kp N2 &kp LC(ENTER)>,
                <&macro_pause_for_release>;

            label = "MC02";
        };

        mc03: mc03 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&kp LANG2 &kp N3 &kp LC(ENTER)>,
                <&macro_pause_for_release>;

            label = "MC03";
        };

        mc04: mc04 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&kp LANG2 &kp MINUS &kp LC(ENTER)>,
                <&macro_pause_for_release>;

            label = "MC04";
        };

        mc05: mc05 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&kp LANG2 &kp DOT &kp LC(ENTER)>,
                <&macro_pause_for_release>;

            label = "MC05";
        };

        mc06: mc06 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&kp LA(LC(V)) &kp T &kp ENTER>,
                <&macro_pause_for_release>;

            label = "MC06";
        };

        mc07: mc07 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&kp LA(LC(V)) &kp F &kp ENTER>,
                <&macro_pause_for_release>;

            label = "MC07";
        };

        mc08: mc08 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&kp LA(LC(V)) &kp V &kp ENTER>,
                <&macro_pause_for_release>;

            label = "MC08";
        };

        mc09: mc09 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LA(H) &kp A &kp L>;
            label = "MC09";
        };

        mc10: mc10 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LA(H) &kp A &kp C>;
            label = "MC10";
        };

        mc11: mc11 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LA(H) &kp A &kp R>;
            label = "MC11";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            bindings = <
&lt 5 Q      &lt 4 W      &lt 3 E        &kp R       &kp T                          &TD01   &kp Y        &lt 3 U  &lt 4 I  &lt 5 O
&lt 2 A      &lt 1 S      &kp D          &kp F       &mt LANG2 G                    &TD02   &mt LANG1 H  &kp J    &kp K    &lt 2 P
&mt LSHFT Z  &mt RSHFT X  &mt LGUI C     &mt LALT V  &mt LCTRL B                    &mm00   &mm01        &kp N    &kp M    &kp L
&kp LCTRL    &TD000       &mt LALT CAPS  &trans      &TD001       &TD002    &TD003  &TD004  &trans       &TD05    &TD06    &TD07
                          &trans         &trans      &trans                         &trans  &trans       &trans
            >;

            sensor-bindings = <&encoder_kp LEFT RIGHT>;
        };

        layer_1 {
            bindings = <
&TD10  &TD11  &TD12   &TD13   &TD14                             &kp HOME   &kp END    &kp N7  &kp N8  &kp N9
&TD15  &TD16  &TD17   &TD18   &TD19                             &kp PG_UP  &kp PG_DN  &kp N4  &kp N5  &kp N6
&TD20  &TD21  &TD22   &TD23   &TD24                             &TD08      &TD09      &kp N4  &kp N5  &kp N6
&TD25  &TD26  &TD27   &trans  &kp ENTER  &kp SPACE    &kp BSPC  &kp TAB    &trans     &kp N0  &TD06   &kp TAB
              &trans  &trans  &trans                            &trans     &trans     &trans
            >;

            sensor-bindings = <&encoder_kp C_BRI_DN C_BRI_UP>;
        };

        layer_2 {
            bindings = <
&kp N7  &kp N8  &kp N9   &kp HOME   &kp END                           &kp LS(RIGHT_BRACKET)  &kp LS(NON_US_HASH)  &kp LS(N6)            &kp LS(N8)        &kp LS(N9)
&kp N4  &kp N5  &kp N6   &kp PG_UP  &kp PG_DN                         &kp RIGHT_BRACKET      &kp NON_US_HASH      &kp LS(N4)            &kp LS(N5)        &kp EQUAL
&kp N1  &kp N2  &kp N3   &TD09      &TD08                             &kp LS(INT3)           &kp LS(EQUAL)        &kp LS(LEFT_BRACKET)  &kp LEFT_BRACKET  &kp LS(N3)
&kp N0  &TD06   &kp TAB  &trans     &kp RET    &kp SPACE    &kp BSPC  &kp TAB                &trans               &kp LS(N7)            &kp SEMI          &kp INT3
                &trans   &trans     &trans                            &trans                 &trans               &trans
            >;

            sensor-bindings = <&encoder_kp C_VOL_DN C_VOL_UP>;
        };

        layer_3 {
            bindings = <
&kp LA(LC(TAB))      &TD28     &kp UP    &TD29      &mt F5 LG(LEFT)                                         &kp LC(T)        &kp LS(LC(TAB))  &kp UP    &kp LC(TAB)  &mt F5 LC(F4)
&kp LS(LG(LEFT))     &kp LEFT  &kp DOWN  &kp RIGHT  &kp LS(LG(RIGHT))                                       &kp LA(LEFT)     &kp LEFT         &kp DOWN  &kp RIGHT    &kp LA(RIGHT)
&mt LC(LSHFT) LC(L)  &trans    &trans    &kp F11    &kp F3                                                  &kp F3           &kp F11          &trans    &trans       &mt LG(RSHFT) LC(L)
&kp LG(P)            &trans    &trans    &trans     &kp LG(KP_MINUS)   &kp LG(KP_PLUS)    &kp LC(KP_MINUS)  &kp LC(KP_PLUS)  &trans           &trans    &trans       &trans
                               &trans    &trans     &trans                                                  &trans           &trans           &trans
            >;

            sensor-bindings = <&encoder_msc SCRL_LEFT SCRL_RIGHT>;
        };

        layer_4 {
            bindings = <
&trans           &kp F1  &kp F2   &kp F3   &kp F4                          &kp HOME   &kp END    &kp N7  &kp N8  &kp N9
&trans           &kp F5  &kp F6   &kp F7   &kp F8                          &kp PG_UP  &kp PG_DN  &kp N4  &kp N5  &kp N6
&trans           &kp F9  &kp F10  &kp F11  &kp F12                         &TD08      &TD09      &kp N1  &kp N2  &kp N3
&kp PRINTSCREEN  &trans  &trans   &trans   &kp RET  &kp SPACE    &kp BSPC  &kp TAB    &trans     &kp N0  &TD06   &kp TAB
                         &trans   &trans   &trans                          &trans     &trans     &trans
            >;

            sensor-bindings = <&encoder_msc SCRL_UP SCRL_DOWN>;
        };

        layer_5 {
            bindings = <
&trans       &bt BT_SEL 0    &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3                            &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3    &trans
&trans       &trans          &trans        &out OUT_USB  &bt BT_SEL 4                            &bt BT_SEL 4  &out OUT_USB  &trans        &trans          &trans
&sys_reset   &trans          &trans        &trans        &trans                                  &trans        &trans        &trans        &trans          &sys_reset
&bootloader  &studio_unlock  &kp LG(L)     &trans        &kp LG(D)     &kp LA(F4)    &kp LA(F4)  &kp LG(D)     &trans        &kp LG(L)     &studio_unlock  &bootloader
                             &trans        &trans        &trans                                  &trans        &trans        &trans
            >;

            sensor-bindings = <&encoder_kp UP DOWN>;
        };

        layer_6 {
            bindings = <
&trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans                    &trans  &trans  &mkp MB1  &mkp MB2  &trans
&trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans    &trans    &trans
                &trans  &trans  &trans                    &trans  &trans  &trans
            >;
        };
    };
};
