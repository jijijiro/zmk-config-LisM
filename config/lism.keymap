            label = "TD10";
            #binding-cells = <0>;
            bindings = <&mc01>, <&mc05>;

            tapping-term-ms = <300>;
        };

        TD11: TD11 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD11";
