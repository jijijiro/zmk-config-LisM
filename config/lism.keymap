            #binding-cells = <0>;
            bindings = <&kp LC(END)>, <&mc06>;

            tapping-term-ms = <300>;
        };

        TD15: TD15 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD15";
            #binding-cells = <0>;
            bindings = <&kp LC(A)>, <&mc09>;

            tapping-term-ms = <300>;
        };

        TD16: TD16 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD16";
            #binding-cells = <0>;
            bindings = <&kp LC(S)>, <&mc10>;

            tapping-term-ms = <300>;
        };

        TD17: TD17 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD17";
            #binding-cells = <0>;
            bindings = <&kp LALT>, <&mc11>;

            tapping-term-ms = <300>;
        };

        TD18: TD18 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD18";
            #binding-cells = <0>;
